          "name": "Create City",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hiroshima\",\n  \"population\": 1194034,\n  \"capital\": false\n}"
