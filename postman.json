  "item": [
    {
      "name": "Countries",
      "item": [
        {
          "name": "Get All Countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/countries",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "countries"]
            },
            "description": "Returns all countries with aggregate city counts and visited city counts."
          },
          "response": []
        },
        {
          "name": "Create Country",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"France\",\n  \"population\": 67000000,\n  \"area\": 551695\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/countries",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "countries"]
            },
            "description": "Creates a new country. Returns 400 if name already exists or fields are missing."
          },
          "response": []
        },
        {
          "name": "Create Country - Duplicate (Error)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Japan\",\n  \"population\": 125700000,\n  \"area\": 377975\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/countries",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "countries"]
            },
            "description": "Attempts to create a duplicate country. Expects 400 error."
          },
          "response": []
        },
        {
          "name": "Create Country - Missing Fields (Error)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Germany\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/countries",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "countries"]
            },
            "description": "Attempts to create a country with missing fields. Expects 400 error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cities",
      "item": [
        {
          "name": "Get Cities for Country",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/country/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "country", "1"]
            },
            "description": "Returns all cities for country with id=1, sorted by name."
          },
          "response": []
        },
        {
          "name": "Get Cities - Country Not Found (Error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/country/9999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "country", "9999"]
            },
            "description": "Attempts to get cities for a non-existent country. Expects 404 error."
          },
          "response": []
        },
