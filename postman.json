            "url": {
              "raw": "http://localhost:3000/api/country/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "country", "1"]
            },
            "description": "Attempts to create a capital city when one already exists. Expects 400 error."
